# Copy to .env and fill in your values, then: source .env

# LLM provider: openrouter (default) or cerebras — also: python voice_agent.py --llm cerebras
# VOICE_LLM_BACKEND=openrouter

# OpenRouter — https://openrouter.ai
OPENROUTER_API_KEY=sk-or-your-key-here
# OPENROUTER_MODEL=deepseek/deepseek-v4-flash:free
# OPENROUTER_REASONING_EFFORT=none             # none=omit reasoning field | low | medium | high

# Cerebras Inference — https://cloud.cerebras.ai (OpenAI-compatible, very fast TTFT)
# VOICE_LLM_BACKEND=cerebras
# CEREBRAS_API_KEY=csk-your-key-here
# CEREBRAS_MODEL=llama3.1-8b                   # fast for voice | llama-3.3-70b | gpt-oss-120b | zai-glm-4.7
# CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
# CEREBRAS_REASONING_FORMAT=hidden             # required for gpt-oss voice (else only delta.reasoning)
# CEREBRAS_REASONING_EFFORT=low                # gpt-oss: low | medium | high

# Webcam vision (hybrid: Cerebras text-only turns, OpenRouter vision when a frame is attached)
# VOICE_VISION=1
# VISION_MODE=both                             # every_turn | phrase | both
# VISION_ATTACH=every_turn                     # default when VISION_MODE=both (unless phrase matches)
# VISION_CAMERA_DEVICE=0
# VISION_CAPTURE_INTERVAL_SEC=0.5
# VISION_MAX_WIDTH=640
# VISION_JPEG_QUALITY=75
# VISION_STARTUP_SEC=8
# VISION_CAMERA_WARMUP_FRAMES=8
# SYSTEM_PROMPT=...                  # override Jullie persona and speech rules
# VISION_SYSTEM_HINT=...             # appended when a camera frame is attached
# VISION_TEXT_ONLY_HINT=...          # appended on text-only turns when VOICE_VISION=1
# VISION_NO_CAMERA_HINT=...          # when user asked to see but camera failed
# OPENROUTER_VISION_MODEL=google/gemini-2.0-flash-001
# OPENROUTER_VISION_MODEL_FALLBACK=google/gemini-2.0-flash-001
# VISION_MIN_WORDS_FOR_AUTO=3
# VISION_MEMORY_FRAMES=3                  # recent user turns that keep JPEGs in LLM context (session)
# VISION_FOLLOWUP=1                       # attach camera on "tell me more" after a vision turn
# VISION_IDLE_INSPECT=1                   # on silence timeout, capture frame + note scene (default with VOICE_VISION)
# VISION_IDLE_COOLDOWN_SEC=45             # min seconds between idle inspects (listen timeout is often 15s)
# VISION_IDLE_PROMPT_DISCUSSION=1         # speak a conversational opener after idle inspect (default on)
# VISION_IDLE_FRESH_CONVERSATION=0        # 1 = wipe turn history before idle opener
# VISION_IDLE_MIN_QUIET_AFTER_SPEECH_SEC=90  # no idle opener soon after you spoke
# VISION_IDLE_INSPECT_SPEAK=0             # if discussion off: speak raw observation aloud
# VISION_IDLE_INSPECT_MAX_TOKENS=120
# VISION_IDLE_DISCUSSION_MAX_TOKENS=180
# VISION_ATTACH=phrase
# Avoid *-reasoning vision models — empty replies are common; fallback retries gemini if set
# Requires OPENROUTER_API_KEY; frames are sent to OpenRouter on attach (not stored on disk).

# Speech-to-text: qwen (MLX, Apple Silicon) or whisper (faster-whisper / CTranslate2)
# VOICE_STT_BACKEND=qwen                    # or whisper — also: python voice_agent.py --stt whisper
# WHISPER_MODEL=base.en                     # tiny.en | base.en | small.en | distil-large-v3, etc.
# WHISPER_DEVICE=auto                       # cpu | cuda | auto (if supported by your faster-whisper)
# WHISPER_COMPUTE_TYPE=default              # int8 | float16 | default — see faster-whisper docs

# Voice agent (voice_agent.py) — mic / VAD / echo
# VOICE_LIST_DEVICES=1                         # print input devices at startup (pick an index)
# VOICE_INPUT_DEVICE=3                       # PortAudio index, or substring of input device name
# VOICE_SILENCE_THRESHOLD=0.012              # RMS below this counts as silence (lower = more sensitive)
# VOICE_SILENCE_SECS=1.8                     # trailing silence duration to end a turn
# VOICE_MIN_SPEECH_SECS=0.25                 # minimum “loud” audio before end-of-utterance is accepted
# VOICE_MAX_RECORD_SECS=30                   # hard cap per listen pass
# VOICE_LISTEN_HEARTBEAT_SEC=5               # log while waiting for speech (0=off)
# VOICE_LLM_HTTP_READ_TIMEOUT=90             # per-chunk read timeout on LLM stream
# VOICE_POST_PLAYBACK_SLEEP=0.25             # pause after TTS before listening (reduces speaker echo)

# Context / memory (voice_agent.py)
# VOICE_MAX_HISTORY_PAIRS=24                 # max user+assistant turn pairs kept verbatim
# VOICE_MAX_CONTEXT_CHARS=10000              # soft cap on total chars in recent turns (0 = off)
# VOICE_MEMORY_NOTES_MAX_CHARS=4000          # max size of compressed “memory notes” in system prompt
# VOICE_MEMORY=1                             # 0/off = no session history or disk saves
# VOICE_MEMORY_PATH=voice_agent_memory.json  # disk persistence when memory is on
# ./run.sh --no-memory                       # CLI: same as VOICE_MEMORY=0 for this run
# VOICE_LLM_MAX_TOKENS=512                   # completion max_tokens (spoken output length)
# VOICE_SPLIT_ON_COMMA=0                     # 1 = shorter TTS chunks (comma splits; more synth calls)
# VOICE_ASYNC_MEMORY_SAVE=1                  # 0 = block loop on disk write after each reply
# WHISPER_BEAM_SIZE=1                        # lower = faster whisper STT (default 1 for voice)

# Hugging Face Hub (Qwen ASR / Kokoro downloads) — optional read token for higher rate limits
# HF_TOKEN=hf_your_token_here                # https://huggingface.co/settings/tokens

# Text-to-speech: kokoro | openai | openvox — also: python voice_agent.py --tts openvox
# VOICE_TTS_BACKEND=openvox

# Kokoro TTS (local)
# KOKORO_REPO_ID=hexgrad/Kokoro-82M
# KOKORO_LANG=a
# KOKORO_VOICE=af_heart
# KOKORO_SPEED=1.0
# KOKORO_SAMPLE_RATE=24000

# OpenAI Speech API (or compatible proxy — POST /audio/speech)
# OPENAI_API_KEY=sk-...
# OPENAI_SPEECH_API_KEY=sk-...               # optional override if LLM uses a different key
# OPENAI_SPEECH_BASE_URL=https://api.openai.com/v1
# OPENAI_SPEECH_MODEL=tts-1                  # tts-1 | tts-1-hd
# OPENAI_SPEECH_VOICE=alloy                  # alloy | echo | fable | onyx | nova | shimmer
# OPENAI_SPEECH_FORMAT=pcm                   # pcm (fastest playback) | wav | mp3 | opus
# OPENAI_SPEECH_SPEED=1.0
# OPENAI_SPEECH_SAMPLE_RATE=24000            # playback rate when using pcm

# OpenVox local voice API (http://127.0.0.1:8000/v1) — use VOICE_TTS_BACKEND=openvox
# OPENVox_BASE_URL=http://127.0.0.1:8000/v1
# OPENVox_MODEL=kokoro                       # omit to auto-pick from GET /models
# OPENVox_LANGUAGE=en
# OPENVox_VOICE=af_bella                     # omit to auto-pick for language
# OPENVox_STREAM=0                           # 1 = SSE audio.chunk streaming per utterance
# OPENVox_429_WAIT=2.0                       # seconds between retries when server is busy
# OPENVox_MAX_RETRIES=12
# OPENVox_PRELOAD_MODELS=active                 # active | all | kokoro,chatterbox-turbo-small

# Startup preload (STT + TTS load; optional synthesis warm-up before first turn)
# VOICE_PRELOAD=1
# VOICE_PRELOAD_WARM_TTS=1
