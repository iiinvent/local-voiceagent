# Copy to .env and fill in your values, then: source .env

# Required — get a free key at https://openrouter.ai
OPENROUTER_API_KEY=sk-or-your-key-here

# Optional overrides
# OPENROUTER_MODEL=google/gemma-3-12b-it:free  # default; see openrouter.ai/models for free options
# WHISPER_MODEL=base.en                          # tiny.en | base.en | small.en | medium.en

# Voice agent (voice_agent.py) — mic / VAD / echo
# VOICE_LIST_DEVICES=1                         # print input devices at startup (pick an index)
# VOICE_INPUT_DEVICE=3                       # PortAudio index, or substring of input device name
# VOICE_SILENCE_THRESHOLD=0.012              # RMS below this counts as silence (lower = more sensitive)
# VOICE_SILENCE_SECS=1.8                     # trailing silence duration to end a turn
# VOICE_MIN_SPEECH_SECS=0.25                 # minimum “loud” audio before end-of-utterance is accepted
# VOICE_MAX_RECORD_SECS=30                   # hard cap per listen pass
# VOICE_POST_PLAYBACK_SLEEP=0.25             # pause after TTS before listening (reduces speaker echo)

# Context / memory (voice_agent.py)
# VOICE_MAX_HISTORY_PAIRS=24                 # max user+assistant turn pairs kept verbatim
# VOICE_MAX_CONTEXT_CHARS=10000              # soft cap on total chars in recent turns (0 = off)
# VOICE_MEMORY_NOTES_MAX_CHARS=4000          # max size of compressed “memory notes” in system prompt
# VOICE_MEMORY_PATH=voice_agent_memory.json  # persist memory + turns across runs (omit to disable)
# VOICE_LLM_MAX_TOKENS=512                   # OpenRouter completion max_tokens (spoken output length)

# Hugging Face Hub (Qwen ASR / Kokoro downloads) — optional read token for higher rate limits
# HF_TOKEN=hf_your_token_here                # https://huggingface.co/settings/tokens

# Kokoro TTS (voice_agent.py)
# KOKORO_REPO_ID=hexgrad/Kokoro-82M          # explicit repo silences Kokoro default warning
# KOKORO_LANG=a
# KOKORO_VOICE=af_heart
# KOKORO_SPEED=1.0
# KOKORO_SAMPLE_RATE=24000
